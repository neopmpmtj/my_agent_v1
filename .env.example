DJANGO_SETTINGS_MODULE=conf.settings.dev
# Generate a local secret, e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ChatGPT OAuth tokens live in <repo>/.auth/openai.json (gitignored). Override the directory if needed.
# AUTH_DIR=
